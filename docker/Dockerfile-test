FROM ubuntu:24.04



RUN apt-get update -q && apt-get upgrade -yq

RUN apt-get update -q && \
    DEBIAN_FRONTEND=noninteractive \
    apt-get install -qy --no-install-recommends \
    git python3 python3-pip \
    python3-dev python3-uhd python3-venv && \
    apt-get clean && rm -rf /var/lib/apt/lists/*


RUN python3 -m venv /opt/venv
ENV PYTHONUNBUFFERED 1
RUN mkdir -p /src
WORKDIR /src
COPY ./ /src
RUN mkdir /opt/venv/lib/python3.12/site-packages/uhd
RUN cp -r /usr/lib/python3/dist-packages/uhd/* /opt/venv/lib/python3.12/site-packages/uhd/
ARG DOCKER_GIT_CREDENTIALS
RUN /opt/venv/bin/python -m pip install --upgrade pip
RUN /opt/venv/bin/python -m pip install --no-cache-dir .[test]

ENTRYPOINT ["/opt/venv/bin/pytest"]
